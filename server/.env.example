# Runtime
NODE_ENV=development
PORT=5000

# Database (MongoDB Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/joinus

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS: allowed client origin(s), comma-separated
CLIENT_ORIGIN=http://localhost:5173

# WebRTC TURN relay (optional, comma-separated urls if multiple)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Metered TURN credentials (optional)
METERED_APP=
METERED_API_KEY=

# Room capacity (1 to 6, default 4)
MAX_PARTICIPANTS=4

# Rate limits (optional overrides)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MS=900000

# Feature Flags (default: false / off)
FEATURE_LANDING=false
FEATURE_NEW_HOME=false
FEATURE_ROOM_VIEWS=false
FEATURE_REACTIONS=false
FEATURE_HOST_SECURITY=false
FEATURE_POLLS=false
FEATURE_CAPTIONS=false
FEATURE_CHAT_PLUS=false
FEATURE_SCHEDULING=false
FEATURE_SETTINGS=false
FEATURE_RECORDING=false
FEATURE_CALENDAR=false
FEATURE_SEARCH=false
FEATURE_WHITEBOARD=false
FEATURE_CONTACTS=false
FEATURE_TEAM_CHAT=false
FEATURE_ACCOUNT_RECOVERY=false
FEATURE_TWO_FACTOR=false
FEATURE_SOCIAL_LOGIN=false
FEATURE_TRANSLATION=false
FEATURE_AI_RECAP=false
FEATURE_AI_COMPANION=false
FEATURE_CALENDAR_SYNC=false
