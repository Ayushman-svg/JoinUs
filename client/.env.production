# Production Environment Variables for JoinUs Client
# These feature flags are embedded into the client build on Vercel
VITE_API_URL=https://joinus-vobk.onrender.com
VITE_FEATURE_LANDING=true
VITE_FEATURE_NEW_HOME=true
VITE_FEATURE_ROOM_VIEWS=true
VITE_FEATURE_REACTIONS=true
VITE_FEATURE_HOST_SECURITY=true
VITE_FEATURE_POLLS=true
VITE_FEATURE_CAPTIONS=true
VITE_FEATURE_CHAT_PLUS=true
VITE_FEATURE_SCHEDULING=true
VITE_FEATURE_SETTINGS=true
